{
  "name": "website",
  "author": "Denis Beliaev",
  "license": "UNLICENSED",
  "type": "module",
  "description": "Website",
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "cssnano": "^7.1.2",
    "eslint": "^9.38.0",
    "eslint-plugin-html": "^8.1.3",
    "gulp": "^5.0.1",
    "gulp-imagemin": "^9.0.0",
    "gulp-php2html": "^1.0",
    "gulp-postcss": "^10.0.0",
    "gulp-sass": "^6.0.1",
    "rimraf": "latest",
    "sass": "^1.77.1",
    "webpack": "^5.0",
    "webpack-cli": "^6.0.1"
  },
  "scripts": {
    "install": "composer install",
    "build": "webpack --mode=production --no-devtool",
    "build-in-pipeline": "yarn && yarn build && gulp publish && php build.php",
    "serve": "concurrently \"php -S localhost:8080 router.php\" \"browser-sync 'http://localhost:8080' ./ -w --port 8000\" \"gulp watch\" \"webpack --watch\""
  },
  "browserslist": [
    "> 1% in RU",
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Opera versions",
    "last 2 Firefox versions",
    "last 2 Safari major versions",
    "last 2 iOS major versions",
    "not dead"
  ],
  "dependencies": {
    "@webcomponents/webcomponentsjs": "^2.0",
    "smoothscroll-polyfill": "^0.4.3"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "eslint:recommended"
    ],
    "env": {
      "browser": true,
      "es6": true,
      "node": true
    },
    "plugins": [
      "html"
    ],
    "parserOptions": {
      "ecmaVersion": 6,
      "sourceType": "module"
    }
  }
}
